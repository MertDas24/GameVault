@page
@model GameVault.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Yeni parola belirle";
}
<section class="auth-card" aria-labelledby="reset-heading">
    <h1 id="reset-heading">Yeni parola belirle</h1>

    @if (Model.LinkMissing)
    {
        <div class="alert alert-error" role="alert">@ResetPasswordModel.InvalidLinkError</div>
        <p class="auth-links"><a href="/Account/ForgotPassword">Yeni bağlantı iste</a></p>
    }
    else
    {
        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">
                @Model.Error
                <a href="/Account/ForgotPassword">Yeni bağlantı iste</a>
            </div>
        }

        <form method="post" class="form" data-busy-form novalidate>
            <input type="hidden" asp-for="Input.UserId">
            <input type="hidden" asp-for="Input.Token">
            <div class="field">
                <label asp-for="Input.Password">Yeni parola</label>
                <input asp-for="Input.Password" autocomplete="new-password" required minlength="10" maxlength="128" autofocus>
                <p class="hint">En az 10 karakter.</p>
                <span asp-validation-for="Input.Password" id="Input_Password-error" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword">Yeni parola (tekrar)</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required maxlength="128">
                <span asp-validation-for="Input.ConfirmPassword" id="Input_ConfirmPassword-error" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block" data-busy-text="Kaydediliyor…">Parolayı güncelle</button>
        </form>
    }
</section>
