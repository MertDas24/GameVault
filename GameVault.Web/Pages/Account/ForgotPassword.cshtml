@page
@model GameVault.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Parolamı unuttum";
}
<section class="auth-card" aria-labelledby="forgot-heading">
    <h1 id="forgot-heading">Parolamı unuttum</h1>

    @if (Model.Sent)
    {
        <div class="alert alert-success" role="status">
            Bu adrese kayıtlı bir hesap varsa parola sıfırlama bağlantısı gönderdik.
            Bağlantı 30 dakika geçerlidir. Gelen kutunu (ve istenmeyen klasörünü) kontrol et.
        </div>
        <p class="auth-links"><a href="/Account/Login">Girişe dön</a></p>
    }
    else
    {
        <p class="muted">Hesabına bağlı e-posta adresini gir; sana bir sıfırlama bağlantısı gönderelim.</p>

        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">@Model.Error</div>
        }

        <form method="post" class="form" data-busy-form novalidate>
            <div class="field">
                <label asp-for="Input.Email">E-posta</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" required maxlength="256" autofocus>
                <span asp-validation-for="Input.Email" id="Input_Email-error" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block" data-busy-text="Gönderiliyor…">Bağlantı gönder</button>
        </form>
        <p class="auth-links"><a href="/Account/Login">Girişe dön</a></p>
    }
</section>
