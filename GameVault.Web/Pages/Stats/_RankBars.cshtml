@model (IReadOnlyList<GameVault.Models.Stats.NamedCount> Items, string Unit)
@{
    // İlk öğe en büyük değerdir (servis azalan sırada döndürür); çubuklar ona göre ölçeklenir.
    var top = Model.Items.Count == 0 ? 1 : Math.Max(1, Model.Items[0].Count);
}
<ol class="rank-bars">
    @foreach (var item in Model.Items)
    {
        <li>
            <span class="rank-row"><span class="break-anywhere">@item.Name</span><span class="rank-value">@Display.Number(item.Count) @Model.Unit</span></span>
            <progress max="@top" value="@item.Count" aria-hidden="true">@item.Count</progress>
        </li>
    }
</ol>
