@model GameCardView
<article class="card">
    <a class="card-link" href="/Library/@Model.Game.Id">
        <partial name="_Cover" model="@((Model.Game.Title, Model.Game.CoverImageUrl, "cover-card"))" />
        <h3 class="card-title" title="@Model.Game.Title">@Model.Game.Title</h3>
    </a>
    <div class="card-meta">
        <span class="badge status-@StatusLabels.Key(Model.Game.Status)">@StatusLabels.Label(Model.Game.Status)</span>
        <span class="card-platform" title="@Model.Game.PlatformName">@Model.Game.PlatformName</span>
    </div>
    <div class="card-foot">
        <span class="card-stats">
            @if (Model.Game.Rating is { } rating)
            {
                <span><span class="visually-hidden">Puan:</span> @rating/10</span>
            }
            <span><span class="visually-hidden">Oynama süresi:</span> @Display.Number(Model.Game.PlaytimeHours) sa</span>
        </span>
        <form method="post" asp-page="/Library/Details" asp-page-handler="Favorite" asp-route-id="@Model.Game.Id" class="fav-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            <button type="submit" class="fav-btn" aria-pressed="@(Model.Game.IsFavorite ? "true" : "false")"
                    aria-label="@(Model.Game.IsFavorite ? "Favorilerden çıkar" : "Favorilere ekle"): @Model.Game.Title">
                <partial name="_Icon" model="@("star")" />
            </button>
        </form>
    </div>
    @if (Model.Collections is { } collections)
    {
        <details class="card-collections">
            <summary><partial name="_Icon" model="@("folder")" /> Koleksiyon<span class="visually-hidden">: @Model.Game.Title</span></summary>
            @if (collections.Count == 0)
            {
                <p class="hint"><a href="/Collections">Önce bir koleksiyon oluştur</a></p>
            }
            else
            {
                <ul class="card-collection-list">
                    @foreach (var c in collections)
                    {
                        var isMember = Model.Game.CollectionIds?.Contains(c.Id) == true;
                        <li>
                            <form method="post" asp-page="/Library/Details" asp-page-handler="Collection" asp-route-id="@Model.Game.Id">
                                <input type="hidden" name="collectionId" value="@c.Id">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                <button type="submit" class="collection-toggle" aria-pressed="@(isMember ? "true" : "false")"
                                        title="@(isMember ? "Koleksiyondan çıkar" : "Koleksiyona ekle")">
                                    <partial name="_Icon" model="@("check")" />
                                    <span class="break-anywhere">@c.Name</span>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </details>
    }
</article>
