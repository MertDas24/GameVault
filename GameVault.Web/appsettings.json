{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "PublicBaseUrl": "",
    "DisplayTimeZone": "Europe/Istanbul"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "FromAddress": "",
    "FromName": "Game Vault"
  },
  "Covers": {
    "AllowedHosts": []
  },
  "Rawg": {
    "BaseUrl": "https://api.rawg.io/api/",
    "TimeoutSeconds": 5
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Security": {
    "UseHttpsRedirection": true,
    "EnableHsts": true
  },
  "Library": {
    "MaxGamesPerUser": 5000
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
